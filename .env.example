# Supabase — create a project at https://supabase.com, then copy these from
# Project Settings → API. Do NOT commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only, NEVER expose to the browser:
# Required for admin-panel writes (add/edit/delete) — without it the
# admin panel falls back to a read-only view of data/circulars.json.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required to open the /admin panel at all. Without it, /admin shows a
# "not configured" notice and nobody can log in.
ADMIN_PASSWORD=<redacted>

# AI CV Maker polish (/api/cv) — get a key from Google AI Studio.
# OPTIONAL: without it the CV maker still works fully, using a template
# Career Objective instead of the AI-polished one.
GEMINI_API_KEY=your-gemini-api-key

# Web Push (new-circular notifications). Generate a VAPID key pair at
# deploy time together with the Supabase wiring, e.g.:
#   npx web-push generate-vapid-keys
# Without these, the notification bell hides itself and /api/push/* stays
# inert. The public key is safe to expose; the private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
