# Supabase — create a project at https://supabase.com, then copy these from
# Project Settings → API. Do NOT commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Later (server-side only, never expose to the browser):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # ingest monitor / admin writes
# ADMIN_PASSWORD=choose-a-strong-password          # admin panel login
